# Copy to .env and fill in your key
# vllm | ollama | openai | gemini | auto
# Default local path: OpenAI-compatible vLLM in WSL2 (see scripts/wsl/README.md)
IMMORTILITY_LLM_PROVIDER=vllm
GEMINI_API_KEY=
# flash is balanced; flash-lite is fastest for chat/voice (when quota allows)
GEMINI_MODEL=gemini-2.0-flash-lite

# ── vLLM (WSL2) — Immortility talks to localhost only ──
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=Qwen/Qwen3-8B
# Optional secondary model on the same server
# IMMORTILITY_FALLBACK_MODEL=Qwen/Qwen3-8B-AWQ

# ── Ollama OpenAI surface (config swap — no code changes) ──
# IMMORTILITY_LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen3:8b
# Optional Qwythos-9B Q4_K_M trial (8GB GPU — not 1M context):
#   ollama pull hf.co/empero-ai/Qwythos-9B-Claude-Mythos-5-1M-GGUF:Q4_K_M
#   ollama create qwythos9b-q4 -f scripts/ollama/Modelfile.qwythos9b-q4
# OLLAMA_MODEL=qwythos9b-q4
# IMMORTILITY_FALLBACK_MODEL=qwen3:8b

# ── Any other OpenAI-compatible server ──
# IMMORTILITY_LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://127.0.0.1:9000/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=your-model-id

# Whisper: small.en = much more accurate than base/tiny (CPU OK on your laptop)
WHISPER_MODEL=small.en
# cpu (default, safe) | cuda. CUDA is probed at startup and falls back to CPU if unusable.
WHISPER_DEVICE=cpu
# Precision when WHISPER_DEVICE=cuda (float16) / cpu (int8)
# WHISPER_COMPUTE=float16
# WHISPER_COMPUTE_CPU=int8

# Optional RAG CrossEncoder rerank (CPU). Default off to leave VRAM for the LLM.
RERANK_ENABLED=0
# RERANK_MODEL=BAAI/bge-reranker-base

# Optional: force which Chrome profile opens sites (Default, Profile 1, …)
# IMMORTILITY_CHROME_PROFILE=Default
# IMMORTILITY_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Optional fixed HUD API token (otherwise a random token is injected into the HUD page)
# IMMORTILITY_HUD_TOKEN=

# ── Web search (API preferred; DuckDuckGo Playwright is the no-key fallback) ──
# auto | tavily | brave | searxng | ddg
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
BRAVE_API_KEY=
# Example: http://127.0.0.1:8080
SEARXNG_URL=
WEB_SEARCH_MAX_RESULTS=5

# ── Self-learning / critic ──
IMMORTILITY_OUTCOME_LEARNING=1
IMMORTILITY_CRITIC=1
# Keep off until outcome/web loops are stable
IMMORTILITY_RESPONSE_TUNER=0
