# Copy to .env and fill in your key
# gemini | ollama | auto — use ollama while Gemini free-tier is exhausted
IMMORTILITY_LLM_PROVIDER=ollama
GEMINI_API_KEY=
# flash is balanced; flash-lite is fastest for chat/voice (when quota allows)
GEMINI_MODEL=gemini-2.0-flash-lite
# Primary: qwen3:8b + higher context — more reliable than 14b on 8GB VRAM.
OLLAMA_MODEL=qwen3:8b
IMMORTILITY_FALLBACK_MODEL=qwen3.5:4b
OLLAMA_NUM_CTX=16384
# Optional partial GPU offload (usually leave unset for 8b)
# OLLAMA_NUM_GPU=22
# Whisper: small.en = much more accurate than base/tiny (CPU OK on your laptop)
WHISPER_MODEL=small.en
# cpu (default, safe) | cuda. CUDA is ~5x faster and lets you run medium.en,
# but needs `pip install nvidia-cublas-cu12` and shares VRAM with Ollama.
# Immortility probes the GPU at startup and silently falls back to CPU if unusable.
WHISPER_DEVICE=cpu
# Precision when WHISPER_DEVICE=cuda (float16) / cpu (int8)
# WHISPER_COMPUTE=float16
# WHISPER_COMPUTE_CPU=int8
# Optional: force which Chrome profile opens sites (Default, Profile 1, …)
# IMMORTILITY_CHROME_PROFILE=Default
# IMMORTILITY_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Optional fixed HUD API token (otherwise a random token is injected into the HUD page)
# IMMORTILITY_HUD_TOKEN=

# ── Ollama-side inference knobs (NOT set by Immortility — set in your OS / Ollama service) ──
# Quantization: choose a smaller/quantized model tag, e.g. qwen3:8b, llama3.2:3b
# Flash Attention (if your Ollama build + GPU support it):
#   set OLLAMA_FLASH_ATTENTION=1 in the environment that runs `ollama serve`
# KV cache: controlled indirectly via OLLAMA_NUM_CTX above
