# Copy to .env and fill in your key
# nvidia | vllm | ollama | openai | gemini | auto
# Primary brain: Kimi K3 through NVIDIA NIM. Never commit the real key.
IMMORTILITY_LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=moonshotai/kimi-k3
# Executable requests use Hermes Agent + Harness through its local native API.
# Hermes API_SERVER_KEY must match HERMES_API_KEY. Bind Hermes to 127.0.0.1 only.
IMMORTILITY_AGENT_BACKEND=hermes
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=
# Hermes must be started with its own API_SERVER_KEY. Keep this separate from NVIDIA_API_KEY.
HERMES_TIMEOUT_SECONDS=300
HERMES_POLL_SECONDS=0.75
GEMINI_API_KEY=
# flash is balanced; flash-lite is fastest for chat/voice (when quota allows)
GEMINI_MODEL=gemini-2.0-flash-lite

# ── vLLM (WSL2) — Immortility talks to localhost only ──
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=Qwen/Qwen3-8B
# Optional secondary model on the same server
# IMMORTILITY_FALLBACK_MODEL=Qwen/Qwen3-8B-AWQ

# ── Ollama OpenAI surface (config swap — no code changes) ──
# IMMORTILITY_LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen3:8b
# Optional Qwythos-9B Q4_K_M trial (8GB GPU — not 1M context):
#   ollama pull hf.co/empero-ai/Qwythos-9B-Claude-Mythos-5-1M-GGUF:Q4_K_M
#   ollama create qwythos9b-q4 -f scripts/ollama/Modelfile.qwythos9b-q4
# OLLAMA_MODEL=qwythos9b-q4
# IMMORTILITY_FALLBACK_MODEL=qwen3:8b

# ── Any other OpenAI-compatible server ──
# IMMORTILITY_LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://127.0.0.1:9000/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=your-model-id

# ── Model fleet (config/models.yaml declares roles; env overrides them) ──
# Check everything with: python -m models.doctor   (or /doctor in the CLI)
# Optional coding specialist. Must fit beside nothing else on 8GB, e.g.
# qwen2.5-coder:7b-instruct-q4_K_M. Unset means the brain handles code.
# OLLAMA_CODE_MODEL=
# Optional vision model (Qwen3-VL class quant). Unset means image
# understanding reports unavailable instead of guessing from text.
# OLLAMA_VISION_MODEL=
# Only for machines with far more VRAM than this laptop (Qwen3-Coder-30B class)
# IMMORTILITY_CODE_LARGE_MODEL=
# Chat context window. 8192 is the safe default on 8GB VRAM; 16384 is the
# tested ceiling. Applied per request on Ollama (forces one model reload).
# IMMORTILITY_NUM_CTX=8192

# Reply length. FAST greetings stay short. Chat/reports default 2048 tokens
# (was 320/520 — that is why long HUD answers stopped mid-sentence).
# Ceiling is 4096 on 8GB VRAM. Voice stays separate (IMMORTILITY_SPEECH_TOKENS).
# IMMORTILITY_CHAT_TOKENS=2048
# IMMORTILITY_CLI_CHAT_TOKENS=2048
# IMMORTILITY_ACTION_SUMMARY_TOKENS=2048
# IMMORTILITY_FAST_CHAT_TOKENS=220

# Whisper: small.en = much more accurate than base/tiny (CPU OK on your laptop)
WHISPER_MODEL=small.en
# cpu (default, safe) | cuda. CUDA is probed at startup and falls back to CPU if unusable.
WHISPER_DEVICE=cpu
# Precision when WHISPER_DEVICE=cuda (float16) / cpu (int8)
# WHISPER_COMPUTE=float16
# WHISPER_COMPUTE_CPU=int8

# Optional RAG CrossEncoder rerank (CPU). Default off to leave VRAM for the LLM.
RERANK_ENABLED=0
# RERANK_MODEL=BAAI/bge-reranker-base

# Optional: force which Chrome profile opens sites (Default, Profile 1, …)
# IMMORTILITY_CHROME_PROFILE=Default
# IMMORTILITY_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Optional fixed HUD API token (otherwise a random token is injected into the HUD page)
# IMMORTILITY_HUD_TOKEN=

# ── Web search (API preferred; DuckDuckGo Playwright is the no-key fallback) ──
# auto | tavily | brave | searxng | ddg
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
BRAVE_API_KEY=
# Example: http://127.0.0.1:8080
SEARXNG_URL=
WEB_SEARCH_MAX_RESULTS=5

# ── Self-learning / critic ──
IMMORTILITY_OUTCOME_LEARNING=1
IMMORTILITY_CRITIC=1
# Keep off until outcome/web loops are stable
IMMORTILITY_RESPONSE_TUNER=0

# ── Command engine (single subprocess path used by run_command, git_*, docker_*) ──
# IMMORTILITY_CMD_TIMEOUT=60
# IMMORTILITY_CMD_MAX_OUTPUT=200000
# Extra git roots besides the Immortility repo and the active project (os.pathsep-separated)
# IMMORTILITY_GIT_ALLOWED_ROOTS=

# ── Configured databases only (no arbitrary URLs from the model) ──
# Also see config/databases.yaml
# IMMORTILITY_SQLITE_PATH=
# IMMORTILITY_SQLITE_ALLOW_WRITE=0
# IMMORTILITY_POSTGRES_URL=
# IMMORTILITY_MONGO_URL=
